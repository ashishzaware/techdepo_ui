# Copy this file to .env.local for local development, and set the same
# values in your hosting provider's environment variable settings for
# production. Nothing in this file is required for the site to build or run
# — enquiry forms fall back to logging to the server console if unset.

# Resend (https://resend.com) API key used to email enquiry form submissions.
# Free tier covers small business volume. Without this, submitted enquiries
# are logged to the server console instead of emailed.
RESEND_API_KEY=

# Email address that receives sales/service/contact enquiry notifications.
# Defaults to the `email` value in src/config/site.ts if unset.
ENQUIRY_TO_EMAIL=

# "From" address used when sending enquiry emails via Resend. Must be from a
# domain verified in your Resend account, or use the Resend sandbox sender
# (onboarding@resend.dev) shown below for testing.
RESEND_FROM_EMAIL="TechDepo Website <onboarding@resend.dev>"

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Analytics only
# loads if this is set — see src/components/Analytics.tsx.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- WhatsApp Business Cloud API (Meta) ---
# Sends (a) a WhatsApp alert to the business on every new enquiry, and
# (b) a "thank you, we'll connect shortly" WhatsApp reply to the customer.
# Requires a Meta Business/WhatsApp Business Platform setup — see the
# "WhatsApp Business API Setup" section in README.md for the full walkthrough.
# Without these, WhatsApp notifications are skipped (logged only) — email
# notifications still work independently via RESEND_API_KEY above.

# Permanent access token from a Meta System User (WhatsApp Business Platform).
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID from Meta's WhatsApp API Setup page (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# Name of the approved template used for the business-side "new enquiry" alert.
# Must match exactly what you submitted in WhatsApp Manager > Message Templates.
WHATSAPP_TEMPLATE_ALERT=new_enquiry_alert

# Name of the approved template used for the customer "thank you" reply.
WHATSAPP_TEMPLATE_THANK_YOU=enquiry_thank_you

# Optional: comma-separated WhatsApp numbers (E.164, no "+", e.g. 918149491025)
# to receive the owner alert. Defaults to every number in siteConfig.contacts
# (src/config/site.ts) if unset.
WHATSAPP_ALERT_NUMBERS=
